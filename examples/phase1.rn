// This is a Rune script, which has a syntax very similar to Rust.

// The `get` function is located in the `http` module we defined in Rust.
// The `sleep` function is at the root of the module.
use http::get;
use sleep;

// All test scripts must have a `pub async fn main()` function,
// which is the entry point for each virtual user.
pub async fn main() {
    println("VU starting: Fetching data from test API...");

    // 1. Make an HTTP GET request to a public test endpoint.
    // The `?` operator will propagate any errors and stop this iteration.
    let response = get("https://httpbin.org/get").await?;

    // 2. Check the response object.
    // The `response` object has a `status` field and a `text()` method,
    // just like we defined in our `rune_api` crate.
    if response.status == 200 {
        // The call to .text() is also async, so it must be awaited.
        let body = response.text()?;
        println(`Success! Response status is ${response.status}.`);
        // In a more complex script, you could parse the `body` string here.
    } else {
        println(`Request failed with status code: ${response.status}`);
    }

    // 3. Simulate user "think time" by pausing the script execution.
    // This is important for creating realistic load patterns.
    println("VU pausing to simulate reading the data...");
    sleep(1.5).await?; // Sleep for 1.5 seconds.

    println("VU finished iteration.");
}
